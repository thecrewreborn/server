cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED TCR_EMBED_OUT OR (DEFINED TCR_EMBED_LIST AND DEFINED TCR_EMBED_LOGO)
   OR NOT (DEFINED TCR_EMBED_LIST OR DEFINED TCR_EMBED_LOGO))
  message(FATAL_ERROR "embed.cmake: set TCR_EMBED_OUT and one of TCR_EMBED_LIST, TCR_EMBED_LOGO")
endif()

string(ASCII 1 TCR_SEMI)
string(ASCII 2 TCR_OPEN)
string(ASCII 3 TCR_CLOSE)
set(TCR_STRING_RE "\"([^\"\\\\]|\\\\.)*\"")

function(tcr_encode out text)
  string(REPLACE ";" "${TCR_SEMI}" text "${text}")
  string(REPLACE "[" "${TCR_OPEN}" text "${text}")
  string(REPLACE "]" "${TCR_CLOSE}" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(tcr_decode out text)
  string(REPLACE "${TCR_SEMI}" ";" text "${text}")
  string(REPLACE "${TCR_OPEN}" "[" text "${text}")
  string(REPLACE "${TCR_CLOSE}" "]" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(tcr_members keys_out values_out text)
  string(REGEX MATCHALL "${TCR_STRING_RE}|[{}:,${TCR_OPEN}${TCR_CLOSE}]|[^{}:,${TCR_OPEN}${TCR_CLOSE}\"]+" tokens
         "${text}")
  set(depth 0)
  set(keys)
  set(values)
  set(key "")
  set(value "")
  set(want_key TRUE)
  foreach(t IN LISTS tokens)
    if(t STREQUAL "{" OR t STREQUAL "${TCR_OPEN}")
      math(EXPR depth "${depth} + 1")
      if(depth EQUAL 1)
        if(NOT t STREQUAL "{")
          message(FATAL_ERROR "embed.cmake: not a JSON object")
        endif()
        continue()
      endif()
    elseif(t STREQUAL "}" OR t STREQUAL "${TCR_CLOSE}")
      math(EXPR depth "${depth} - 1")
      if(depth EQUAL 0)
        if(NOT key STREQUAL "")
          list(APPEND keys "${key}")
          list(APPEND values "${value}")
        endif()
        continue()
      endif()
    elseif(depth EQUAL 1)
      if(t STREQUAL ",")
        list(APPEND keys "${key}")
        list(APPEND values "${value}")
        set(key "")
        set(value "")
        set(want_key TRUE)
        continue()
      elseif(want_key)
        set(key "${t}")
        set(want_key FALSE)
        continue()
      elseif(t STREQUAL ":" AND value STREQUAL "")
        continue()
      endif()
    endif()
    string(APPEND value "${t}")
  endforeach()
  set(${keys_out} "${keys}" PARENT_SCOPE)
  set(${values_out} "${values}" PARENT_SCOPE)
endfunction()

function(tcr_object out keys values)
  set(text "")
  foreach(key value IN ZIP_LISTS keys values)
    if(NOT text STREQUAL "")
      string(APPEND text ",")
    endif()
    string(APPEND text "${key}:${value}")
  endforeach()
  set(${out} "{${text}}" PARENT_SCOPE)
endfunction()

function(tcr_unquote out token)
  if(token MATCHES "\\\\")
    message(FATAL_ERROR "embed.cmake: an escape in ${token}")
  endif()
  string(REGEX REPLACE "^\"(.*)\"$" "\\1" token "${token}")
  set(${out} "${token}" PARENT_SCOPE)
endfunction()

function(tcr_without_source out text)
  tcr_members(keys values "${text}")
  list(FIND keys "\"source\"" at)
  if(at GREATER -1)
    list(REMOVE_AT keys ${at})
    list(REMOVE_AT values ${at})
    tcr_object(text "${keys}" "${values}")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(tcr_neutral_replies out text)
  tcr_members(keys values "${text}")
  set(new_values)
  foreach(key value IN ZIP_LISTS keys values)
    if(value MATCHES "^{")
      tcr_members(entry_keys entry_values "${value}")
      list(FIND entry_keys "\"name\"" at)
      if(at GREATER -1)
        list(GET entry_values ${at} name)
        if(name MATCHES "^\"")
          tcr_unquote(name "${name}")
          tcr_unquote(rid "${key}")
          string(TOLOWER "${rid}" lower)
          if(lower MATCHES "^0x")
            string(SUBSTRING "${rid}" 2 -1 rid)
          endif()
          string(TOUPPER "${rid}" rid)
          string(LENGTH "${name}" name_length)
          string(LENGTH "_${rid}" rid_length)
          math(EXPR prefix_length "${name_length} - ${rid_length}")
          if(prefix_length GREATER 0 AND NOT name MATCHES "^AUTO_")
            string(SUBSTRING "${name}" 0 ${prefix_length} prefix)
            string(SUBSTRING "${name}" ${prefix_length} -1 suffix)
            if(prefix MATCHES "^[A-Z]+$" AND suffix STREQUAL "_${rid}")
              list(REMOVE_AT entry_values ${at})
              list(INSERT entry_values ${at} "\"REQ_${rid}\"")
              tcr_object(value "${entry_keys}" "${entry_values}")
            endif()
          endif()
        endif()
      endif()
    endif()
    list(APPEND new_values "${value}")
  endforeach()
  tcr_object(text "${keys}" "${new_values}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(tcr_layouts_only out text)
  tcr_members(keys values "${text}")
  set(new_keys)
  set(new_values)
  foreach(key value IN ZIP_LISTS keys values)
    tcr_unquote(name "${key}")
    if(name MATCHES "^_")
      continue()
    endif()
    tcr_members(entry_keys entry_values "${value}")
    list(FIND entry_keys "\"layout\"" at)
    if(at EQUAL -1)
      message(FATAL_ERROR "embed.cmake: no layout for ${key}")
    endif()
    list(GET entry_values ${at} layout)
    list(APPEND new_keys "${key}")
    list(APPEND new_values "{\"layout\":${layout}}")
  endforeach()
  tcr_object(text "${new_keys}" "${new_values}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(tcr_compact out name path)
  file(READ "${path}" text)
  if(text MATCHES "[^\t\n\r -~]")
    message(FATAL_ERROR "embed.cmake: ${path}: a character outside printable ASCII")
  endif()
  string(REGEX REPLACE "(${TCR_STRING_RE})|[\t\n\r ]+" "\\1" text "${text}")
  if(text MATCHES "^{")
    tcr_encode(text "${text}")
    if(text MATCHES "\"source\":")
      tcr_without_source(text "${text}")
    endif()
    if(name STREQUAL "replies.json")
      tcr_neutral_replies(text "${text}")
    elseif(name STREQUAL "replies_schema.json")
      tcr_layouts_only(text "${text}")
    endif()
    tcr_decode(text "${text}")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(tcr_array out file)
  file(READ "${file}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REPEAT "0x..," 32 line)
  string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

function(tcr_write path text)
  if(EXISTS "${path}")
    file(READ "${path}" old)
    if(old STREQUAL text)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${text}")
endfunction()

if(DEFINED TCR_EMBED_LOGO)
  file(SIZE "${TCR_EMBED_LOGO}" logo_size)
  tcr_array(logo "${TCR_EMBED_LOGO}")
  if(DEFINED TCR_EMBED_NAME)
    get_filename_component(source_name "${TCR_EMBED_LOGO}" NAME)
    set(text "// Generated by native/cmake/embed.cmake from ${source_name}. Do not edit.\n")
  else()
    set(TCR_EMBED_NAME kLogo)
    set(text "// Generated by native/cmake/embed.cmake from the avatar logo. Do not edit.\n")
  endif()
  string(APPEND text "static const unsigned char ${TCR_EMBED_NAME}[${logo_size}] = {\n${logo}};\n")
  tcr_write("${TCR_EMBED_OUT}" "${text}")
  return()
endif()

include("${TCR_EMBED_LIST}")
set(scratch "${TCR_EMBED_OUT}.tmp")
set(lines "// Generated by native/cmake/embed.cmake from the server's JSON tables. Do not edit.\n")
string(APPEND lines "#include \"core/embedded.h\"\n\nnamespace tcr {\nnamespace embedded {\n\nnamespace {\n\n")
set(entries "")
set(count 0)
list(LENGTH TCR_EMBED_TABLES n)
math(EXPR odd "${n} % 2")
if(n EQUAL 0 OR odd)
  message(FATAL_ERROR "embed.cmake: TCR_EMBED_TABLES is not pairs of name and file")
endif()
math(EXPR last "${n} - 1")
foreach(i RANGE 0 ${last} 2)
  math(EXPR j "${i} + 1")
  list(GET TCR_EMBED_TABLES ${i} name)
  list(GET TCR_EMBED_TABLES ${j} path)
  tcr_compact(text "${name}" "${path}")
  file(WRITE "${scratch}" "${text}")
  tcr_array(bytes "${scratch}")
  string(LENGTH "${text}" size)
  math(EXPR size1 "${size} + 1")
  string(APPEND lines "// ${name}\nconst unsigned char kTable${count}[${size1}] = {\n${bytes}")
  if(NOT bytes MATCHES "\n$")
    string(APPEND lines "\n")
  endif()
  string(APPEND lines "0};\n\n")
  string(APPEND entries "  {\"${name}\", kTable${count}, ${size}},\n")
  math(EXPR count "${count} + 1")
endforeach()
file(REMOVE "${scratch}")
string(APPEND lines "}  // namespace\n\nconst Table kTables[${count}] = {\n${entries}};\n")
string(APPEND lines "const size_t kTableCount = ${count};\n\n}  // namespace embedded\n}  // namespace tcr\n")
tcr_write("${TCR_EMBED_OUT}" "${lines}")
