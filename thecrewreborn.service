# systemd unit that runs The Crew Reborn server on the internet (see "Running a server on the internet" in the README).
# Adjust User= and the paths to your setup, then:
#   sudo cp thecrewreborn.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now thecrewreborn
[Unit]
Description=The Crew Reborn server
After=network-online.target
Wants=network-online.target

[Service]
# A normal user that owns the server folder; "crew" is an example.
User=crew
# Example path: the folder with TheCrewReborn-Server. The server keeps config.ini, save, certs and captures there.
WorkingDirectory=/opt/thecrewreborn
ExecStart=/opt/thecrewreborn/TheCrewReborn-Server
Restart=on-failure
RestartSec=5
# Lets the server bind ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Room for many players: every HTTP connection and capture file needs a file handle (the default limit is 1024).
LimitNOFILE=65536
# Hardening. ProtectSystem=full makes /usr, /boot and /etc read-only; /opt stays writable, so the server folder
# (saves, certificate, captures) is unaffected. ProtectHome=true hides /home: do not put the server folder there.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
